# Normalização de fim de linha do plugin TrazoMob
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.txt  text eol=lf
*.glsl text eol=lf
*.vert text eol=lf
*.frag text eol=lf
*.ies  text eol=lf

# Arquivos binários/devem permanecer intactos
*.png  binary
*.jpg  binary
*.jpeg binary
*.exr  binary
*.hdr  binary
*.blend binary
*.blend1 binary
*.glb  binary
*.gltf text eol=lf
*.fbx  binary
*.obj  text eol=lf
